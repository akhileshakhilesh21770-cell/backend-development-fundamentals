# Node.js dependencies – NEVER commit these
node_modules/

# Environment variables – NEVER commit secrets
.env
.env.local
.env.production
.env.*

# macOS system file
.DS_Store

# Windows thumbnail cache
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# Runtime data
pids/
*.pid
*.seed

# Editor folders
.vscode/
.idea/

# OS-generated files
desktop.ini
